# Copy to frontend/.env to change frontend runtime behaviour.

# Data source:
#   unset / VITE_USE_MOCK=1  -> labelled sample fixtures (works with no backend)
#   VITE_USE_MOCK=0          -> live: call the FastAPI backend at /api/* (proxied
#                              to http://127.0.0.1:8000). A pure connection
#                              failure still falls back to a fixture; real HTTP
#                              error statuses (403/404/422/503) propagate.
VITE_USE_MOCK=0
